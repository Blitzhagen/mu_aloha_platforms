-// v161: xHC PORTSC-Watch — wann stirbt der USB-Link (RxDetect)?
-// Phys-Basis 0x0A600000 = PlatformMemoryMapLib "USB"-Eintrag (DWC3/xHC).
-// CAPLENGTH-Byte @+0x00 -> opreg base; PORTSCn @opreg+0x400+0x10*n.
-#define XWATCH_XHC_PHYS  0x0A600000ULL
-
-STATIC UINT32
-XWatchPort (
-  UINTN  Port
-  )
-{
-  volatile UINT8  *Base = (volatile UINT8 *)(UINTN)XWATCH_XHC_PHYS;
-  return *(volatile UINT32 *)(Base + Base[0] + 0x400 + 0x10 * Port);
-}
-
-STATIC VOID
-XWatch (
-  CONST CHAR8  *Tag
-  )
-{
-  DEBUG ((DEBUG_ERROR, "XWATCH %a: psc0=%x psc1=%x\n", Tag, XWatchPort (0), XWatchPort (1)));
-}
-
-// v169: dwc3-SUSPHY/LPM-Bits erneut pruefen+loeschen - erkennt ob QC-Code
-// sie nach DxeMain wieder gesetzt hat (re-arm).
-STATIC VOID
-Dwc3Fix (
-  CONST CHAR8  *Tag
-  )
-{
-  volatile UINT8   *DwcBase = (volatile UINT8 *)(UINTN)XWATCH_XHC_PHYS;
-  volatile UINT32  *PipeCtl = (volatile UINT32 *)(DwcBase + 0xC2C0);
-  volatile UINT32  *PhyCfg  = (volatile UINT32 *)(DwcBase + 0xC200);
-  UINT32           P0       = *PipeCtl;
-  UINT32           G0       = *PhyCfg;
-  *PipeCtl = P0 & ~((UINT32)(1u << 17) | (1u << 27));
-  *PhyCfg  = G0 & ~((UINT32)(1u << 6) | (1u << 8));
-  DEBUG ((DEBUG_ERROR, "DWC3FIX-%a pipe %x->%x gusb2 %x->%x\n", Tag, P0, *PipeCtl, G0, *PhyCfg));
-}
-
-// v157: BlockIo-Read-Stress - prueft ob lange sequentielle Reads
-// (Ramdisk-Aufbau ~630MB) den Mu-USB-Stack haengen. Liest jeden
-// Removable-Handle (Disk + Partitionen) bis zu STRESS_MAX_BYTES
-// sequentiell in 4MB-Chunks, loggt Zeit/Durchsatz je 16MB.
-// Haengt der Stack, zeigt das PStore-Fenster die letzte gute LBA.
-#define STRESS_CHUNK_BYTES  (4 * 1024 * 1024)
-#define STRESS_LOG_EVERY    (16 * 1024 * 1024)
-#define STRESS_MAX_BYTES    ((UINT64)64 * 1024 * 1024)
-#define STRESS_MAX_ERRS     4
-
-VOID
-StressUsbBlockRead (
-  VOID
-  )
-{
-  EFI_HANDLE              *H;
-  UINTN                   C, I;
-  EFI_STATUS              St;
-  EFI_BLOCK_IO_PROTOCOL   *Bio;
-  UINTN                   Blk;
-  UINT64                  MediaBytes, TotalBytes, Done, T0, Dt;
-  UINT8                   *Buf;
-  UINTN                   Errs;
-
-  St = gBS->LocateHandleBuffer (ByProtocol, &gEfiBlockIoProtocolGuid, NULL, &C, &H);
-  if (EFI_ERROR (St) || (C == 0)) {
-    DEBUG ((DEBUG_ERROR, "STRESS: no BlockIo handles (%r)\n", St));
-    return;
-  }
-
-  DEBUG ((DEBUG_ERROR, "STRESS: %d blockio handles\n", (UINT32)C));
-  for (I = 0; I < C; I++) {
-    St = gBS->HandleProtocol (H[I], &gEfiBlockIoProtocolGuid, (VOID **)&Bio);
-    if (EFI_ERROR (St) || (Bio == NULL) || (Bio->Media == NULL)) {
-      continue;
-    }
-    if (!Bio->Media->RemovableMedia) {
-      continue;   // nur den Stick - UFS auslassen
-    }
-
-    Blk = (UINTN)Bio->Media->BlockSize;
-    if (Blk == 0) {
-      continue;
-    }
-    MediaBytes = ((UINT64)Bio->Media->LastBlock + 1) * Blk;
-    TotalBytes = MIN (MediaBytes, STRESS_MAX_BYTES);
-    DEBUG ((
-      DEBUG_ERROR,
-      "STRESS h%d: blk %d media %ldMB ioalign %d lastblk %ld lp %d -> %ldMB zu lesen\n",
-      (UINT32)I, (UINT32)Blk, MediaBytes / 1048576,
-      (UINT32)Bio->Media->IoAlign, (UINT64)Bio->Media->LastBlock,
-      (UINT32)Bio->Media->LogicalPartition, TotalBytes / 1048576
-      ));
-
-    Buf = AllocatePages (EFI_SIZE_TO_PAGES (STRESS_CHUNK_BYTES));
-    if (Buf == NULL) {
-      DEBUG ((DEBUG_ERROR, "STRESS h%d: alloc %d failed\n", (UINT32)I, (UINT32)STRESS_CHUNK_BYTES));
-      continue;
-    }
-
-    Errs = 0;
-    Done = 0;
-    T0   = GetPerformanceCounter ();
-    while (Done < TotalBytes) {
-      UINTN     Want;
-      EFI_LBA   Lba;
-      UINT64    C0;
-      UINTN     Ms;
-
-      Want = (UINTN)MIN ((UINT64)STRESS_CHUNK_BYTES, TotalBytes - Done);
-      Lba  = Done / Blk;
-      C0   = GetPerformanceCounter ();
-      St   = Bio->ReadBlocks (Bio, Bio->Media->MediaId, Lba, Want, Buf);
-      Dt   = GetPerformanceCounter () - C0;
-      Ms   = (UINTN)(GetTimeInNanoSecond (Dt) / 1000000);
-      if (EFI_ERROR (St)) {
-        Errs++;
-        DEBUG ((DEBUG_ERROR, "STRESS h%d: lba %ld %dB -> %r (errs %d)\n",
-                (UINT32)I, (UINT64)Lba, (UINT32)Want, St, (UINT32)Errs));
-        if (Errs >= STRESS_MAX_ERRS) {
-          break;
-        }
-      } else if (((Done % STRESS_LOG_EVERY) == 0) || (Ms > 2000)) {
-        DEBUG ((
-          DEBUG_ERROR,
-          "STRESS h%d: lba %ld %dB in %dms (%ld MB/s)\n",
-          (UINT32)I, (UINT64)Lba, (UINT32)Want, (UINT32)Ms,
-          Ms ? (UINT64)Want * 1000 / ((UINT64)Ms * 1048576) : 0
-          ));
-      }
-
-      Done += Want;
-    }
-
-    Dt = GetPerformanceCounter () - T0;
-    {
-      UINTN  TotMs = (UINTN)(GetTimeInNanoSecond (Dt) / 1000000);
-      DEBUG ((
-        DEBUG_ERROR,
-        "STRESS h%d END: %ldMB in %dms = %ld MB/s, errs %d\n",
-        (UINT32)I, Done / 1048576, (UINT32)TotMs,
-        TotMs ? Done * 1000 / ((UINT64)TotMs * 1048576) : 0, (UINT32)Errs
-        ));
-    }
-    FreePages (Buf, EFI_SIZE_TO_PAGES (STRESS_CHUNK_BYTES));
-  }
-  DEBUG ((DEBUG_ERROR, "STRESS: all removable handles done\n"));
-}
 
