index 04b2e4c4..36019033 100644
--- a/PcBdsPkg/MsBootPolicy/MsBootPolicy.inf
+++ b/PcBdsPkg/MsBootPolicy/MsBootPolicy.inf
@@ -54,6 +54,7 @@
