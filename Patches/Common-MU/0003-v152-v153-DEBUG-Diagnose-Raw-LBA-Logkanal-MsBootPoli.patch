+// v151: privates Mu-Log-Fenster in PStore-Mitte (QC-frei) -
+// identisch zu MULOG_* in FrameBufferInMemorySerialPortLib.c
+#define MU_LOG_BASE_OFF  0x100000
+#define MU_LOG_SIZE      0x2C0000
+#define MU_LOG_LBA_TAIL  0x20000   // 64MB vor Partitions-Ende schreiben
+
+// v153: reiner Raw-Kanal. Schreibt nur die tatsaechlich genutzten
+// Log-Bytes (Offset-Counter am Fensterende) auf fixe LBA - kein
+// Filesystem involviert, Write dauert ms statt Sekunden.
+VOID
+DumpMuLogRawBlocks (
+  IN EFI_HANDLE  FsHandle
+  )
+{
+  EFI_BLOCK_IO_PROTOCOL  *Bio;
+  UINT8                  *Buf;
+  UINTN                  BufSize, TagLen, Total, Used;
+  EFI_LBA                Lba;
+  EFI_STATUS             St;
+  static CHAR8           Tag[] = "==== UEFI-LOG v153 RAW ====\n";
+
+  St = gBS->HandleProtocol (FsHandle, &gEfiBlockIoProtocolGuid, (VOID **)&Bio);
+  if (EFI_ERROR (St) || (Bio == NULL) || (Bio->Media == NULL)) {
+    return;
+  }
+  if (Bio->Media->ReadOnly || !Bio->Media->RemovableMedia) {
+    return;   // nur den Stick, nicht UFS
+  }
+
+  ARM_MEMORY_REGION_DESCRIPTOR_EX  Ps;
+  if (EFI_ERROR (LocateMemoryMapAreaByName ("PStore", &Ps))) {
+    return;
+  }
+
+  UINTN  Blk = (UINTN)Bio->Media->BlockSize;
+  if (Blk == 0) {
+    return;
+  }
+  // letzte 8 Bytes des Fensters = Schreibposition des Serial-Backends
+  Used = *(volatile UINTN *)(UINTN)(Ps.Address + MU_LOG_BASE_OFF + MU_LOG_SIZE - sizeof (UINTN));
+  if (Used > MU_LOG_SIZE - sizeof (UINTN)) {
+    Used = MU_LOG_SIZE - sizeof (UINTN);
+  }
+  TagLen  = sizeof (Tag) - 1;
+  BufSize = ((TagLen + Blk - 1) / Blk + (Used + Blk - 1) / Blk) * Blk;
+  Buf     = AllocateZeroPool (BufSize);
+  if (Buf == NULL) {
+    DEBUG ((DEBUG_ERROR, "PSTORE-DUMP: raw alloc %d failed\n", (UINT32)BufSize));
+    return;
+  }
+  CopyMem (Buf, Tag, TagLen);
+  CopyMem (Buf + ((TagLen + Blk - 1) / Blk) * Blk, (VOID *)(UINTN)(Ps.Address + MU_LOG_BASE_OFF), Used);
+  WriteBackInvalidateDataCacheRange (Buf, BufSize);
+
+  Total = (UINTN)Bio->Media->LastBlock + 1;
+  if (Total > MU_LOG_LBA_TAIL + BufSize / Blk) {
+    Lba = Total - MU_LOG_LBA_TAIL;
+    DEBUG ((DEBUG_ERROR, "PSTORE-DUMP: raw write %d bytes @lba %lu\n", (UINT32)BufSize, (UINT64)Lba));
+    St  = Bio->WriteBlocks (Bio, Bio->Media->MediaId, Lba, BufSize, Buf);
+    DEBUG ((DEBUG_ERROR, "PSTORE-DUMP: raw -> %r\n", St));
+  }
+  FreePool (Buf);
+}
+// v149: kompletten PStore-Serialring auf das erste beschreibbare
+// FAT-Volume dumpen (Stick-ESP oder UFS-Partition) - macht Logs ohne
+// Screen/ramoops lesbar.
+VOID
+DumpPStoreToFile (
+  VOID
+  )
+{
+  EFI_HANDLE  *H;
+  UINTN       C, I;
+  EFI_STATUS  St;
+
+  St = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &C, &H);
+  if (EFI_ERROR (St) || (C == 0)) {
+    DEBUG ((DEBUG_ERROR, "PSTORE-DUMP: no SFS handles (%r)\n", St));
+    return;
+  }
+  DEBUG ((DEBUG_ERROR, "PSTORE-DUMP: %d sfs handles\n", (UINT32)C));
+  for (I = 0; I < C; I++) {
+    DumpMuLogRawBlocks (H[I]);
+  }
+}
