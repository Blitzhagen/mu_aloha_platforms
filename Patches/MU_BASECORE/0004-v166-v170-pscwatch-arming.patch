@@ -13,6 +13,26 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 // Driver Support Functions
 //
 
+// v167: PORTSC live watch, armed at ReadyToBoot (see Event.c)
+BOOLEAN  gPscWatchArmed = FALSE;
+
+#define PSCWATCH_XHC_PHYS  0x0A600000ULL
+
+STATIC UINT32
+PscWatchRead (
+  UINTN  Port
+  )
+{
+  volatile UINT8  *Base;
+
+  if (!gPscWatchArmed) {
+    return 0;
+  }
+
+  Base = (volatile UINT8 *)(UINTN)PSCWATCH_XHC_PHYS;
+  return *(volatile UINT32 *)(Base + Base[0] + 0x400 + 0x10 * Port);
+}
